# ข้อมูลลูกค้าสำหรับชุดเทสต์ที่ยิง backend จริง (npm run test:e2e:real)
#
# วิธีใช้: copy ไฟล์นี้เป็น .env.e2e แล้วใส่ค่าจริง
#   copy .env.e2e.example .env.e2e
#
# .env.e2e ถูก gitignore ไว้แล้ว เพราะเป็นข้อมูลส่วนบุคคล ห้าม commit
#
# ค่าที่ใส่ต้องตรงกับ 1 แถวในตาราง drrs.tbl_cus_target ที่ status = '1'
#   E2E_FIRST_NAME   = first_name
#   E2E_LAST_NAME    = last_name
#   E2E_VERIFY_CODE  = verify_code (รหัสตัวเลข 4 หลักที่ได้จากธนาคาร)
#   E2E_ACCOUNT_NO   = เลขบัญชีที่ยังไม่ได้ลงทะเบียน (step_confirm_plan = '0')
#                      ใช้สำหรับ assert ว่าบันทึกลงบัญชีถูกใบ
#
# ดูค่าที่ใช้ได้ด้วย SQL:
#   SELECT first_name, last_name, verify_code FROM drrs.tbl_cus_target WHERE status = '1';
#   SELECT account_no, step_confirm_plan FROM drrs.tbl_settings_step ORDER BY account_no;

E2E_FIRST_NAME=
E2E_LAST_NAME=
E2E_VERIFY_CODE=
E2E_ACCOUNT_NO=
